---
import '@fontsource-variable/archivo';
import '../styles/global.css';
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex"/><title>Page introuvable — Dwenn Kaufmann</title><link rel="icon" href="/favicon.svg" /></head><body><main class="missing"><a href="/" class="wordmark" aria-label="Dwenn Kaufmann"><span class="wordmark-symbol" aria-hidden="true">&lt;/&gt;</span>Dwenn Kaufmann</a><p class="eyebrow" data-fr="Page introuvable" data-en="Page not found">Page introuvable</p><h1>404<span>.</span></h1><p data-fr="Cette page n’existe pas, ou son adresse a changé." data-en="This page doesn’t exist, or its address has changed.">Cette page n’existe pas, ou son adresse a changé.</p><a class="button missing-back" href="/"><span data-fr="Retour à l’accueil" data-en="Back to the homepage">Retour à l’accueil</span> ↗</a></main><script>if(location.pathname.startsWith('/en/')){document.documentElement.lang='en';document.title='Page not found — Dwenn Kaufmann';document.querySelectorAll<HTMLElement>('[data-en]').forEach(e=>e.textContent=e.dataset.en!);document.querySelector('.missing-back')?.setAttribute('href','/en/');document.querySelector('.wordmark')?.setAttribute('href','/en/');}</script><style>.missing{min-height:100svh;padding:40px var(--gutter);background:var(--paper);color:var(--ink)}.missing>.eyebrow{margin-top:15vh;color:var(--muted)}.missing h1{font-size:clamp(140px,24vw,360px);margin:25px 0 35px;letter-spacing:-.08em}.missing h1>span{color:var(--muted)}.missing>p:not(.eyebrow){color:var(--muted)}.missing .button{margin-top:30px}.missing .button span{font-size:14px}</style></body></html>
