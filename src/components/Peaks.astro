---
import { type Lang } from '../content/site';
import { clients } from '../content/peaks';
interface Props { lang: Lang; interactive?: boolean }
const { lang, interactive = false } = Astro.props;
const fr = lang === 'fr';
---
<section class="peaks-section" id="peaks" aria-labelledby="peaks-heading" data-peaks-interactive={interactive ? '' : undefined}>
  <div class="peaks-inner">
    <div class="peaks-heading"><div><p class="peaks-label">{fr ? 'Sites clients' : 'Client websites'}</p><h2 id="peaks-heading">{fr ? 'Fondateur de Peaks.' : 'Founder of Peaks.'}</h2></div><p>{fr ? 'Avec Peaks, je conçois et développe des sites pour les petites entreprises. Voici trois projets que j’ai réalisés.' : 'Through Peaks, I design and build websites for small businesses. Here are three projects I’ve worked on.'}</p></div>
    <div class="client-list">{clients.map(client=><article class="client-project">
      <a class="client-image" href={client.url} target="_blank" rel="noreferrer"><span class="client-image-media"><img src={client.image} width="1440" height="900" alt={client[lang].alt} loading="lazy" decoding="async" /></span>{interactive && <span class="client-image-label" aria-hidden="true">{fr ? 'Voir le site' : 'Visit website'}<span>↗</span></span>}<span class="sr-only">{fr?'Ouvrir le site dans un nouvel onglet':'Open website in a new tab'}</span></a>
      <div class="client-caption"><h3><a href={client.url} target="_blank" rel="noreferrer">{client.name}<span aria-hidden="true">↗</span></a></h3><p class="client-type">{client[lang].type}</p><p class="client-description">{client[lang].text}</p><a class="client-case" href={client.case} target="_blank" rel="noreferrer">{fr?'Étude de cas':'Case study'}<span aria-hidden="true">↗</span><span class="sr-only">{fr?' (nouvel onglet)':' (new tab)'}</span></a></div>
    </article>)}</div>
    <div class="peaks-outro"><p>{fr ? 'Pour le site web de votre entreprise, retrouvez-moi chez Peaks.' : 'For your business website, get in touch through Peaks.'}</p><a href="https://peaks.ch/contact/" target="_blank" rel="noreferrer">{fr ? 'Contacter Peaks' : 'Contact Peaks'}<span aria-hidden="true">↗</span><span class="sr-only">{fr?' (nouvel onglet)':' (new tab)'}</span></a></div>
  </div>
</section>
<script>
  if (document.querySelector('[data-peaks-interactive]')) {
    import('../scripts/peaks-motion').then(({ initPeaksMotion }) => initPeaksMotion());
  }
</script>
<style>
.peaks-section{background:var(--paper);color:var(--ink);padding:0 var(--gutter);position:relative}.peaks-inner{max-width:1344px;margin:0 auto;border-top:1px solid var(--line);padding:58px 0 60px}.peaks-heading{display:grid;grid-template-columns:1.2fr 1fr;gap:70px;align-items:end;margin-bottom:38px}.peaks-label{font:12px/1.5 var(--mono,monospace);color:var(--muted);margin-bottom:18px}.peaks-heading h2{font-size:clamp(32px,4.25vw,64px);line-height:1.08;letter-spacing:-.045em;font-weight:600;max-width:650px}.peaks-heading>p{font-size:17px;line-height:1.75;color:var(--muted);max-width:460px}.client-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:30px}.client-image{display:block;overflow:hidden;border:1px solid var(--line);background:var(--dark)}.client-image img{width:100%;height:auto;aspect-ratio:1.6;object-fit:cover;transition:transform .3s ease}.client-image:hover img{transform:scale(1.025)}.client-caption{padding-top:22px}.client-caption h3{font-size:29px;line-height:1.2;letter-spacing:-.035em;font-weight:550}.client-caption h3>a{display:flex;justify-content:space-between;align-items:center;gap:16px}.client-caption h3 span{font-size:24px;font-weight:400}.client-type{font:11px/1.5 var(--mono,monospace);color:var(--muted);margin-top:10px}.client-description{font-size:15px;line-height:1.75;margin-top:16px;max-width:380px}.client-case{font-size:12px;display:inline-flex;align-items:center;gap:16px;margin-top:17px;border-bottom:1px solid var(--line);padding:6px 0}.client-case:hover{border-color:var(--ink)}.peaks-outro{display:flex;justify-content:space-between;align-items:center;gap:30px;border-top:1px solid var(--line);margin-top:38px;padding-top:27px}.peaks-outro p{font-size:15px;line-height:1.7;color:var(--muted)}.peaks-outro>a{display:inline-flex;gap:24px;align-items:center;border-bottom:1px solid var(--ink);padding:8px 0;font-size:14px;white-space:nowrap}.sr-only{position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:1000px){.peaks-heading{gap:40px}.client-list{gap:22px}.client-caption h3{font-size:25px}.client-description{font-size:14px}}
@media(max-width:800px){.peaks-inner{padding:36px 0 40px}.peaks-heading{grid-template-columns:1fr;gap:20px;margin-bottom:29px}.peaks-heading h2{font-size:42px;max-width:500px}.peaks-heading>p{font-size:15px}.peaks-label{margin-bottom:15px}.client-list{grid-template-columns:1fr;gap:34px}.client-project{display:grid;grid-template-columns:1.15fr 1fr;gap:25px;align-items:start}.client-project+.client-project{border-top:1px solid var(--line);padding-top:30px}.client-caption{padding-top:0}.client-caption h3{font-size:25px}.client-type{font-size:10px;margin-top:7px}.client-description{font-size:14px;line-height:1.7;margin-top:11px}.client-case{font-size:12px;margin-top:11px}.peaks-outro{align-items:start}.peaks-outro p{font-size:14px}}
@media(max-width:600px){.peaks-heading h2{font-size:39px}.client-project{display:block}.client-image{margin-top:0}.client-caption{padding-top:18px}.client-caption h3{font-size:27px}.client-type{font-size:10px}.client-description{font-size:14px;margin-top:12px}.client-case{font-size:12px}.peaks-outro{display:block;margin-top:30px;padding-top:23px}.peaks-outro>a{margin-top:15px;font-size:13px}}
@media(prefers-reduced-motion:reduce){.client-image img{transition:none}.client-image:hover img{transform:none}}
.client-image{position:relative}.client-image-media{display:block;overflow:hidden;aspect-ratio:1.6}.client-image-media img{display:block;height:100%}.client-image:focus-visible{outline:2px solid var(--ink);outline-offset:5px}.client-image-label{position:absolute;z-index:1;right:12px;bottom:12px;display:inline-flex;align-items:center;gap:20px;padding:12px 15px;background:var(--dark);border:1px solid #a0a2a680;color:var(--ink);border-radius:30px;font:11px/1.3 var(--mono,monospace);white-space:nowrap;pointer-events:none}.client-image-label>span{font:17px/1 var(--sans)}
[data-peaks-interactive] .client-image::after{content:'';position:absolute;inset:0;pointer-events:none;box-shadow:inset 0 0 0 1px #f1f1ee99;opacity:0;transition:opacity .22s ease}[data-peaks-interactive] .client-image:hover::after,[data-peaks-interactive] .client-image:focus-visible::after{opacity:1}[data-peaks-interactive] .client-image img{transition:none}[data-peaks-interactive] .client-image:hover img{transform:none}
.client-image[data-pointer-label] .client-image-label{top:0;left:0;right:auto;bottom:auto;opacity:0;transition:opacity .16s ease}.client-image[data-pointer-label][data-label-visible] .client-image-label,.client-image[data-pointer-label]:focus-visible .client-image-label{opacity:1}
@media(max-width:800px){.client-image-label{padding:10px 12px;gap:15px;font-size:10px}.client-image-label>span{font-size:15px}}
@media(prefers-reduced-motion:reduce){[data-peaks-interactive] .client-image::after,.client-image-label{transition:none}}
</style>
