---
interface Props { lang: 'fr' | 'en' }
const { lang } = Astro.props;
const copy = lang === 'fr' ? {
  name: 'Votre nom', namePlaceholder: 'Prénom et nom',
  email: 'Votre e-mail', emailPlaceholder: 'vous@exemple.ch',
  message: 'Votre projet', messagePlaceholder: 'Décrivez le besoin et ce que vous souhaitez construire.',
  required: 'Tous les champs sont obligatoires.', send: 'Envoyer mon message',
  security: 'Vérification de sécurité en cours…', securityLabel: 'Protection contre les messages indésirables',
  privacy: 'Votre message arrive directement dans ma boîte mail. Je l’utilise uniquement pour vous répondre.',
  protected: 'Protégé par Cloudflare Turnstile.', fallback: 'Vous préférez votre messagerie ?',
  retry: 'Réessayer la vérification', noScript: 'JavaScript est nécessaire à la vérification de sécurité. Vous pouvez aussi m’écrire à',
} : {
  name: 'Your name', namePlaceholder: 'First and last name',
  email: 'Your email', emailPlaceholder: 'you@example.com',
  message: 'Your project', messagePlaceholder: 'Describe the problem and what you want to build.',
  required: 'All fields are required.', send: 'Send my message',
  security: 'Running the security check…', securityLabel: 'Spam protection',
  privacy: 'Your message goes straight to my inbox. I only use it to reply to you.',
  protected: 'Protected by Cloudflare Turnstile.', fallback: 'Prefer your own email app?',
  retry: 'Retry the security check', noScript: 'JavaScript is needed for the security check. You can also email me at',
};
---

<form id="contact-form" class="contact-form" action="/api/contact" method="post" data-language={lang} novalidate>
  <p class="contact-form__required">{copy.required}</p>
  <div class="contact-form__row">
    <div class="contact-form__field">
      <label for="contact-name"><span class="contact-form__number" aria-hidden="true">01</span>{copy.name}</label>
      <input id="contact-name" name="name" placeholder={copy.namePlaceholder} autocomplete="name" minlength="2" maxlength="80" required aria-describedby="contact-name-error" />
      <p id="contact-name-error" class="contact-form__field-error"></p>
    </div>
    <div class="contact-form__field">
      <label for="contact-email"><span class="contact-form__number" aria-hidden="true">02</span>{copy.email}</label>
      <input id="contact-email" name="email" placeholder={copy.emailPlaceholder} type="email" autocomplete="email" maxlength="254" required aria-describedby="contact-email-error" />
      <p id="contact-email-error" class="contact-form__field-error"></p>
    </div>
  </div>
  <div class="contact-form__field contact-form__field--message">
    <label for="contact-message"><span class="contact-form__number" aria-hidden="true">03</span>{copy.message}</label>
    <textarea id="contact-message" name="message" placeholder={copy.messagePlaceholder} minlength="10" maxlength="4000" rows="4" required aria-describedby="contact-message-error"></textarea>
    <p id="contact-message-error" class="contact-form__field-error"></p>
  </div>
  <div class="contact-form__honeypot" aria-hidden="true">
    <label for="contact-website">Website</label>
    <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <div class="contact-form__security">
    <div id="turnstile-widget" aria-label={copy.securityLabel}></div>
    <p id="contact-status" class="contact-form__status" role="status" aria-live="polite" aria-atomic="true" data-state="loading">{copy.security}</p>
    <button id="contact-retry" class="contact-form__retry" type="button" hidden>{copy.retry}</button>
  </div>
  <button id="contact-submit" class="contact-form__submit" type="submit" disabled>
    <span class="submit-label">{copy.send}</span><span class="contact-form__arrow" aria-hidden="true">↗</span>
  </button>
  <p class="contact-form__privacy">{copy.privacy}</p>
  <p class="contact-form__meta">{copy.protected} {copy.fallback} <a href="mailto:hello@dwenn.ch">hello@dwenn.ch</a></p>
  <noscript><p class="contact-form__noscript">{copy.noScript} <a href="mailto:hello@dwenn.ch">hello@dwenn.ch</a>.</p></noscript>
</form>

<script>
  import '../scripts/contact';
</script>

<style>
  .contact-form { --form-ink: var(--ink, #f1f1ee); color-scheme: dark; width: 100%; color: var(--form-ink); }
  .contact-form__required { margin: 0 0 2rem; font-size: .72rem; color: var(--muted, #a0a2a6); }
  .contact-form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  .contact-form__field { min-width: 0; }
  .contact-form__field label { display: flex; align-items: baseline; gap: .75rem; font-size: .8rem; font-weight: 600; }
  .contact-form__number { font: .65rem var(--mono, monospace); color: var(--muted, #a0a2a6); }
  .contact-form input, .contact-form textarea { display: block; width: 100%; box-sizing: border-box; border: 0; border-bottom: 1px solid var(--line, #343538); border-radius: 0; padding: 1.1rem 0; background: transparent; font: inherit; font-size: 1rem; line-height: 1.6; color: inherit; transition: border-color .2s; }
  .contact-form textarea { resize: vertical; min-height: 160px; }
  .contact-form input::placeholder, .contact-form textarea::placeholder { opacity: 1; color: var(--muted, #a0a2a6); }
  .contact-form input:focus-visible, .contact-form textarea:focus-visible { outline: 2px solid var(--form-ink); outline-offset: 5px; }
  .contact-form input[aria-invalid='true'], .contact-form textarea[aria-invalid='true'] { border-color: #ffaaa5; }
  .contact-form__field-error { min-height: 1.3em; margin: .5rem 0 1.5rem; color: #ffaaa5; font-size: .75rem; line-height: 1.5; }
  .contact-form__honeypot { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .contact-form__security { margin: 0 0 1rem; }
  .contact-form__status { min-height: 1.5em; margin: .5rem 0; font-size: .8rem; line-height: 1.6; }
  .contact-form__status[data-state='error'] { color: #ffaaa5; }
  .contact-form__status[data-state='success'] { color: #b6d8b5; font-weight: 600; }
  .contact-form__retry { border: 0; padding: .3rem 0; background: transparent; color: inherit; font: inherit; font-size: .8rem; text-decoration: underline; text-underline-offset: .25em; cursor: pointer; }
  .contact-form__submit { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 72px; border: 1px solid var(--form-ink); padding: 1.2rem 1.5rem; background: var(--form-ink); color: var(--paper, #111214); font: inherit; font-size: 1.05rem; cursor: pointer; transition: opacity .2s, background .2s, color .2s; }
  .contact-form__submit:hover:enabled { background: transparent; color: var(--form-ink); }
  .contact-form__submit:disabled { background: #343538; border-color: #343538; color: #c4c5c8; cursor: not-allowed; }
  .contact-form__submit:focus-visible, .contact-form__retry:focus-visible, .contact-form a:focus-visible { outline: 2px solid currentColor; outline-offset: 5px; }
  .contact-form__arrow { font-size: 2rem; line-height: 1; }
  .contact-form__privacy { margin: 1.4rem 0 .5rem; max-width: 55ch; font-size: .75rem; line-height: 1.65; }
  .contact-form__meta { margin: 0; font-size: .68rem; line-height: 1.7; color: var(--muted, #a0a2a6); }
  .contact-form__meta a, .contact-form__noscript a { text-decoration: underline; text-underline-offset: .2em; }
  .contact-form__noscript { font-size: .8rem; line-height: 1.6; }
  @media (max-width: 600px) { .contact-form__row { grid-template-columns: 1fr; gap: 0; } .contact-form__submit { min-height: 72px; } }
  @media (prefers-reduced-motion: reduce) { .contact-form *, .contact-form *::before { transition: none !important; } }
</style>
