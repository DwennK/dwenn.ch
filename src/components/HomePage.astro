---
import { type Lang, path, profile } from '../content/site';
import { projects } from '../content/projects';
import Peaks from './Peaks.astro';
import ProjectInspector from './ProjectInspector.astro';
import CanapeyPlayground from './CanapeyPlayground.astro';
import HomeCommands from './HomeCommands.astro';
import {projectInspectors} from '../content/project-inspector';
interface Props { lang:Lang }
const {lang}=Astro.props; const fr=lang==='fr';
const ordered=[projects[2],projects[0],projects[1]];
const capabilities=fr?[
 {name:'Interfaces web',text:'Je dessine les écrans et je les développe. Du premier clic aux petits détails qui rendent un site agréable à utiliser.',tools:'Vue / Nuxt / Astro / GSAP'},
 {name:'API & données',text:'Ce qui se passe après le clic : les règles métier, les droits d’accès et les données à retrouver au bon endroit.',tools:'TypeScript / SQL / Cloudflare'},
 {name:'Logiciels desktop',text:'Des applications qui tournent sur l’ordinateur, avec une interface web et du Rust pour travailler avec le système.',tools:'Tauri / Rust / SQLite'}
]:[
 {name:'Web interfaces',text:'I design the screens and build them. From the first click to the small details that make a site feel good to use.',tools:'Vue / Nuxt / Astro / GSAP'},
 {name:'APIs & data',text:'What happens after the click: business rules, access permissions and keeping data in the right place.',tools:'TypeScript / SQL / Cloudflare'},
 {name:'Desktop software',text:'Applications that run on your computer, with a web interface and Rust to work with the operating system.',tools:'Tauri / Rust / SQLite'}
];
const descriptions={fr:{canapey:'Un lanceur Windows pour utiliser son PC depuis le canapé.',pos:'Une application pour gérer les ventes et les réparations d’un magasin.',salaires:'Un logiciel gratuit pour préparer les fiches de salaire en Suisse.'},en:{canapey:'A Windows launcher for using your PC from the sofa.',pos:'An application for managing a shop’s sales and repairs.',salaires:'Free desktop software for preparing Swiss payslips.'}};
---
<div class="developer-home">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-intro-line"><span class="eyebrow">{fr?'Dwenn Kaufmann / Développeur indépendant':'Dwenn Kaufmann / Independent developer'}</span><HomeCommands lang={lang}/></div>
    <h1 id="home-title" class="home-title" aria-label="Full stack."><span class="title-word" aria-hidden="true">{[...'Full'].map(letter=><span class="title-letter">{letter}</span>)}</span>{' '}<span class="title-word" aria-hidden="true">{[...'stack'].map(letter=><span class="title-letter">{letter}</span>)}<span class="title-letter title-dot">.</span></span></h1>
    <div class="home-workspace" id="projects">
      <div class="home-introduction">
        <p class="home-lead">{fr?<>Je développe des sites web<br /> et des applications.</>:<>I build websites<br /> and applications.</>}</p>
        <p class="home-description">{fr?'Je m’occupe du design, du code et de ce qui tourne derrière. Ici, vous trouverez les projets sur lesquels je travaille.':'I handle the design, the code and the systems behind it. Here are some of the projects I’m working on.'}</p>
        <div class="hero-actions"><a class="button" href={path('work',lang)}>{fr?'Voir mes projets':'Explore my work'}<span aria-hidden="true">↗</span></a><a class="hero-contact" href={path('contact',lang)}>{fr?'Me contacter':'Get in touch'}<span aria-hidden="true">↗</span></a></div>
        <div class="home-capabilities"><span class="eyebrow">{fr?'Du premier écran à la base de données':'From the first screen to the database'}</span>{capabilities.map((item,index)=><details name="capabilities"><summary><span class="capability-index">0{index+1}</span>{item.name}<span class="capability-plus" aria-hidden="true">+</span></summary><div><p>{item.text}</p><span>{item.tools}</span></div></details>)}</div>
      </div>
      <div class="workspace-anchor" data-workspace-anchor>
      <div class="project-console" data-project-console>
        <div class="console-titlebar"><span><span class="console-mark" aria-hidden="true">&lt;/&gt;</span>{fr?'Mes projets, de l’intérieur':'Inside my projects'}</span><button type="button" data-workspace-expand aria-haspopup="dialog" aria-controls="workspace-dialog" aria-label={fr?'Agrandir l’explorateur de projets':'Expand project explorer'}><span class="expand-label">{fr?'Agrandir':'Expand'}</span><svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7 3H3v4m10-4h4v4M3 13v4h4m10-4v4h-4" stroke="currentColor" stroke-width="1.4"/></svg></button></div>
        <div class="console-tabs" role="tablist" aria-label={fr?'Aperçu des projets':'Project previews'}>
          {ordered.map((p,i)=><button class:list={['console-tab',{'is-active':i===0}]} role="tab" id={`tab-${p.key}`} aria-controls={`panel-${p.key}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-project-tab={i}><span class="tab-file" aria-hidden="true">{i===0?'↗':i===1?'⌘':'≡'}</span>{p.name}</button>)}
        </div>
        {ordered.map((p,i)=><div class="console-panel" role="tabpanel" id={`panel-${p.key}`} aria-labelledby={`tab-${p.key}`} hidden={i!==0} data-project-panel={i}>
          <div class="console-toolbar"><span class="console-path">projects / {p.slug}</span><div class="console-modes" role="tablist" aria-label={fr?'Explorer ce projet':'Explore this project'}>{(p.key==='canapey'?['preview','code','play']:['preview','code']).map((mode,j)=><button type="button" role="tab" id={`mode-${p.key}-${mode}`} aria-controls={`view-${p.key}-${mode}`} aria-selected={j===0?'true':'false'} tabindex={j===0?0:-1} data-console-mode={mode}><span aria-hidden="true">{mode==='preview'?'◫':mode==='code'?'〈〉':'▷'}</span>{mode==='preview'?(fr?'Aperçu':'Preview'):mode==='code'?'Code':(fr?'Essayer':'Try it')}</button>)}</div></div>
          <div class="console-view" data-console-view="preview" id={`view-${p.key}-preview`} role="tabpanel" aria-labelledby={`mode-${p.key}-preview`}>
            <a class="console-screen" href={path(p.key,lang)} aria-label={`${fr?'Découvrir':'Explore'} ${p.name}`}><img src={p.image} alt={p[lang].imageAlt} width="1440" height={p.key==='salaires'?1165:900} loading={i===0?'eager':'lazy'} fetchpriority={i===0?'high':'auto'} /><span class="screen-open" aria-hidden="true">↗</span></a>
            <div class="console-architecture"><span class="architecture-heading">{fr?'Sous le capot':'Under the hood'}<span aria-hidden="true">↴</span></span><div>{projectInspectors[p.key].roles.map((role,index)=><button type="button" data-open-source={index} aria-label={`${fr?'Explorer':'Explore'} ${role.label[lang]}`}><span class="architecture-index">0{index+1}</span><span><b>{role.label[lang]}</b><small>{role.stack.slice(0,2).join(' / ')}</small></span><span class="architecture-arrow" aria-hidden="true">↗</span></button>)}</div></div>
          </div>
          <div class="console-view" data-console-view="code" id={`view-${p.key}-code`} role="tabpanel" aria-labelledby={`mode-${p.key}-code`} hidden><ProjectInspector lang={lang} project={p}/></div>
          {p.key==='canapey'&&<div class="console-view" data-console-view="play" id="view-canapey-play" role="tabpanel" aria-labelledby="mode-canapey-play" hidden><CanapeyPlayground lang={lang}/></div>}
          <div class="console-info"><div><span class="eyebrow">{p.name}</span><p>{descriptions[lang][p.key]}</p></div><a href={path(p.key,lang)} class="console-case" aria-label={`${fr?'Voir le projet':'View project'} ${p.name}`}><span aria-hidden="true">↗</span></a></div>
          <div class="console-bottom"><span>{p.stack.slice(0,3).join(' / ')}</span><span>{p.key==='canapey'?(fr?'Projet expérimental':'Experimental project'):(fr?'Interface réelle · Données de démo':'Real interface · Demo data')}</span></div>
        </div>)}
        <div class="console-counter" aria-hidden="true"><span data-project-count>01</span><span>/ 03</span></div>
      </div>
      <p class="workspace-hint"><span aria-hidden="true">↖</span>{fr?'Cliquez, explorez le code, essayez.':'Click, explore the code, try it out.'}</p>
      </div>
    </div>
    <div class="home-baseline"><span class="eyebrow">{fr?'Web · Applications métier · Logiciels desktop':'Web · Business applications · Desktop software'}</span><a href="#peaks" class="eyebrow">{fr?'Les sites clients':'Client websites'} <span aria-hidden="true">↓</span></a></div>
  </section>
  <Peaks lang={lang} interactive/>
  <section class="home-person" id="about">
    <a href={path('about',lang)} class="home-portrait"><img src={profile.portrait} width="709" height="945" alt={fr?'Dwenn Kaufmann':'Portrait of Dwenn Kaufmann'} loading="lazy" /></a>
    <div class="home-person-copy"><span class="eyebrow">{fr?'Et derrière le clavier':'The person behind the keyboard'}</span><h2>{fr?'Moi, c’est Dwenn.':'I’m Dwenn.'}</h2><p>{fr?'Je programme depuis l’enfance. Aujourd’hui, je partage mon temps entre les projets de mes clients chez Peaks et mes propres logiciels. J’aime autant soigner une interface que comprendre pourquoi un bout de code ne fait pas ce qu’il devrait.':'I’ve been programming since I was a kid. These days, I split my time between client projects at Peaks and my own software. I enjoy getting an interface right as much as figuring out why a piece of code isn’t doing what it should.'}</p><a class="text-link" href={path('about',lang)}>{fr?'Un peu plus sur moi':'A bit more about me'}<span aria-hidden="true">↗</span></a></div>
    <a class="home-github" href={profile.github}><span aria-hidden="true">&lt;/&gt;</span><span>{fr?'Mes projets sur':'Find my projects on'}<b>GitHub ↗</b></span></a>
  </section>
  <dialog id="workspace-dialog" class="workspace-dialog" aria-label={fr?'Explorateur de projets agrandi':'Expanded project explorer'}><div class="workspace-dialog-bar"><span>{fr?'Explorateur de projets':'Project explorer'}</span><button type="button" data-workspace-close>{fr?'Réduire':'Collapse'}<span aria-hidden="true">Esc ↙</span></button></div><div data-workspace-mount></div></dialog>
</div>
<script>
 import {initHome} from '../scripts/home';
 initHome();
</script>
<style>
.developer-home{overflow:clip}.home-hero{padding:35px var(--gutter) 0}.home-intro-line{display:flex;align-items:center;justify-content:space-between;gap:25px;color:var(--muted)}.home-intro-line>span:last-child{display:flex;gap:55px}.home-title{font-size:clamp(130px,19.25vw,360px);font-weight:600;letter-spacing:-.07em;line-height:.86;margin:40px 0 48px;white-space:nowrap}.title-word{display:inline-block;white-space:nowrap;overflow:clip;padding-bottom:.09em;margin-bottom:-.09em}.title-letter{display:inline-block;transform-origin:50% 100%}.title-dot{color:#75787e}.home-workspace{display:grid;grid-template-columns:minmax(260px,.77fr) minmax(0,1.65fr);gap:6.5vw;align-items:start}.home-introduction{padding-top:20px;max-width:350px}.home-lead{font-size:clamp(21px,2.05vw,33px);line-height:1.18;letter-spacing:-.045em;font-weight:500}.home-description{font-size:14px;line-height:1.65;color:var(--muted);margin-top:20px;max-width:310px}.hero-actions{display:flex;flex-wrap:wrap;align-items:center;gap:12px 24px;margin-top:30px}.hero-actions .button{font-size:12px;gap:28px;min-height:48px;padding:11px 17px}.hero-contact{font-size:12px;min-height:44px;display:inline-flex;align-items:center;gap:16px}.hero-contact:hover{text-decoration:underline;text-underline-offset:6px}.home-tools{margin-top:56px}.home-tools>.eyebrow{font-size:9px;color:#83868c}.home-tools p{font-family:var(--mono);font-size:10px;line-height:1.9;margin-top:10px;color:#cacbcc}.project-console{position:relative;min-width:0;background:#191a1d;border:1px solid #45464a;border-radius:7px;box-shadow:0 35px 80px -35px #0009;transform-origin:50% 30%}.console-tabs{display:flex;border-bottom:1px solid #393a3d;background:#1c1d20;border-radius:6px 6px 0 0;padding:0 12px}.console-tab{border:0;border-right:1px solid #343538;background:transparent;color:#9e9fa6;font-family:var(--mono);font-size:10px;display:flex;align-items:center;gap:9px;min-height:43px;padding:0 16px;position:relative;cursor:pointer}.console-tab.is-active{background:#292a2e;color:var(--ink)}.console-tab.is-active::after{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:#d5d6da}.tab-file{font-size:13px;color:#a6a9b1}.console-toolbar{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:10px 15px;color:#a2a4ab;font-family:var(--mono);font-size:8px;min-height:34px}.console-type{color:#83868c}.console-screen{display:block;position:relative;overflow:hidden;background:#16181c;aspect-ratio:1.85;border-top:1px solid #343538;border-bottom:1px solid #343538}.console-screen img{width:100%;height:100%;object-fit:cover;object-position:top;transition:transform .65s cubic-bezier(.2,.7,.2,1)}.console-screen:hover img{transform:scale(1.025)}.screen-open{position:absolute;bottom:16px;right:16px;display:grid;place-items:center;background:#111214e8;border:1px solid #c0c3c76b;color:white;width:40px;height:40px;font-size:25px;border-radius:50%;transition:background .2s,color .2s}.console-screen:hover .screen-open{background:var(--ink);color:var(--paper)}.console-info{display:flex;justify-content:space-between;gap:20px;padding:17px 20px 15px}.console-info .eyebrow{font-size:9px;color:#c7c9ce}.console-info p{font-size:12px;line-height:1.5;color:#b1b3b9;margin-top:5px}.console-case{font-size:27px;display:flex;align-items:center;justify-content:center;min-width:42px;min-height:44px}.console-bottom{display:flex;justify-content:space-between;gap:20px;font-family:var(--mono);font-size:8px;color:#989aa1;border-top:1px solid #343538;padding:9px 20px}.console-counter{position:absolute;right:0;bottom:-38px;display:flex;gap:14px;font-family:var(--mono);font-size:10px;color:var(--muted)}.console-counter>span:first-child{color:var(--ink)}.home-baseline{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:70px 0 28px;border-bottom:1px solid var(--line);color:var(--muted)}.home-baseline>a{color:var(--ink);display:flex;gap:24px;min-height:44px;align-items:center}.home-person{display:grid;grid-template-columns:200px minmax(0,1fr) 170px;align-items:center;gap:5vw;margin:0 var(--gutter);padding:90px 0 110px;border-top:1px solid var(--line)}.home-portrait{display:block;overflow:hidden;aspect-ratio:1}.home-portrait img{width:100%;height:100%;object-fit:cover;object-position:50% 24%;filter:grayscale(1)}.home-person-copy>.eyebrow{color:var(--muted)}.home-person h2{font-size:clamp(40px,4.4vw,74px);margin:18px 0 22px}.home-person-copy>p{font-size:14px;color:var(--muted);max-width:580px}.home-person .text-link{margin-top:18px;font-size:12px}.home-github{display:flex;gap:15px;align-items:center;font-size:11px;justify-self:end}.home-github>span:first-child{font-family:var(--mono);font-size:31px;letter-spacing:-.15em;color:var(--muted)}.home-github b{display:block;font-size:19px;font-weight:500;margin-top:4px}
@media(min-width:801px) and (max-height:800px){.home-hero{padding-top:24px}.home-title{font-size:17vw;margin-top:26px;margin-bottom:34px}.home-introduction{padding-top:0}.home-tools{margin-top:30px}.console-screen{aspect-ratio:2.2}.home-baseline{padding-top:58px}}
@media(min-width:1800px){.home-workspace{grid-template-columns:.9fr 1.4fr}.home-introduction{max-width:440px}.home-description{max-width:400px;font-size:18px}.home-lead{font-size:40px}}
@media(max-width:1100px) and (min-width:801px){.home-workspace{gap:4vw;grid-template-columns:.85fr 1.55fr}.home-description{font-size:13px}.home-tools{margin-top:30px}.hero-actions{gap:5px 15px}.console-tab{font-size:9px;padding:0 10px}.console-type{display:none}.console-info p{font-size:11px}.home-person{grid-template-columns:170px 1fr;gap:5vw}.home-github{display:none}}
@media(max-width:800px){.home-hero{padding-top:27px}.home-intro-line{font-size:8px}.home-intro-line>.eyebrow{font-size:9px}.home-intro-line>span:last-child{display:none}.home-title{font-size:22vw;line-height:.94;letter-spacing:-.07em;margin:31px 0 31px}.home-workspace{display:flex;flex-direction:column;gap:33px}.home-introduction{padding:0;max-width:none;width:100%}.home-lead{font-size:27px;line-height:1.15;letter-spacing:-.045em}.home-lead br{display:contents}.home-description{font-size:13px;margin-top:14px;max-width:350px}.hero-actions{margin-top:20px;gap:15px 24px}.hero-actions .button{min-height:46px;font-size:11px;gap:35px}.hero-contact{font-size:11px}.home-tools{display:none}.project-console{width:100%;border-radius:5px}.console-tabs{padding:0 4px}.console-tab{font-size:8px;gap:6px;min-height:42px;padding:0 9px;flex:1;justify-content:center;white-space:nowrap}.tab-file{font-size:10px}.console-toolbar{padding:9px 10px;font-size:7px;min-height:29px}.console-type{display:none}.console-screen{aspect-ratio:1.6}.console-screen img{object-position:25% top}.screen-open{width:31px;height:31px;bottom:10px;right:10px;font-size:20px}.console-info{padding:13px 13px 12px;gap:10px}.console-info .eyebrow{font-size:8px}.console-info p{font-size:11px;max-width:260px;line-height:1.4}.console-case{font-size:24px;min-width:32px}.console-bottom{padding:8px 12px;font-size:7px;gap:10px;flex-wrap:wrap}.console-counter{bottom:-30px;font-size:9px}.home-baseline{padding-top:58px;padding-bottom:20px;align-items:start}.home-baseline>.eyebrow{font-size:8px;max-width:160px;line-height:1.8}.home-baseline>a{font-size:8px;gap:13px;min-height:32px}.home-person{grid-template-columns:85px 1fr;gap:22px;padding:60px 0 65px;align-items:start}.home-portrait{aspect-ratio:.83}.home-person-copy>.eyebrow{font-size:8px}.home-person h2{font-size:35px;margin:12px 0 20px}.home-person-copy>p{font-size:13px}.home-person .text-link{font-size:11px;gap:18px;margin-top:15px}.home-github{display:none}}
@media(max-width:360px){.home-title{font-size:21.6vw}.home-lead{font-size:24px}.console-tab{font-size:7px;padding:0 6px}.tab-file{display:none}.home-person{grid-template-columns:65px 1fr;gap:17px}.home-person h2{font-size:29px}}

