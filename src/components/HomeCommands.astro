---
import { type Lang, path, profile } from '../content/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const fr = lang === 'fr';
const entries = [
  { id: 'home', label: fr ? 'Accueil' : 'Home', detail: fr ? 'Dwenn Kaufmann — développeur full stack' : 'Dwenn Kaufmann — full stack developer', href: path('home', lang), kind: fr ? 'Page' : 'Page', keywords: 'home accueil dwenn kaufmann portfolio developer développeur', external: false },
  { id: 'work', label: fr ? 'Projets' : 'Work', detail: fr ? 'Produits personnels et projets web' : 'Personal products and web projects', href: path('work', lang), kind: fr ? 'Page' : 'Page', keywords: 'work projects projets réalisations portfolio products', external: false },
  { id: 'about', label: fr ? 'À propos' : 'About', detail: fr ? 'Mon parcours et ma façon de construire' : 'My background and how I build', href: path('about', lang), kind: fr ? 'Page' : 'Page', keywords: 'about à propos parcours experience expérience skills compétences', external: false },
  { id: 'contact', label: 'Contact', detail: fr ? 'Parlons de votre projet' : 'Tell me about your project', href: path('contact', lang), kind: fr ? 'Page' : 'Page', keywords: 'contact email message mail projet hello', external: false },
  { id: 'pos', label: 'POS Téléphonie', detail: fr ? 'Caisse, réparations et gestion de magasin' : 'Point of sale, repairs and store management', href: path('pos', lang), kind: fr ? 'Produit' : 'Product', keywords: 'pos telephonie caisse réparation réparations magasin nuxt vue point sale repair stock billing', external: false },
  { id: 'salaires', label: 'Easy Salaires', detail: fr ? 'Gestion des salaires pour les PME' : 'Payroll management for small businesses', href: path('salaires', lang), kind: fr ? 'Produit' : 'Product', keywords: 'easy salaires salaire payroll paie pme salary tauri rust employee employé', external: false },
  { id: 'canapey', label: 'Canapey', detail: fr ? 'Le launcher pour PC de salon' : 'The launcher for a living room PC', href: path('canapey', lang), kind: fr ? 'Produit' : 'Product', keywords: 'canapey launcher games gaming jeux jeu manette controller salon pc tauri rust', external: false },
  { id: 'github', label: 'GitHub', detail: fr ? 'Mon code et mes projets publics' : 'My code and public projects', href: profile.github, kind: fr ? 'Externe' : 'External', keywords: 'github code source repo repository dépôts dev', external: true },
  { id: 'peaks', label: 'Peaks', detail: fr ? 'Mon agence web pour les petites entreprises' : 'My web agency for small businesses', href: 'https://peaks.ch', kind: fr ? 'Externe' : 'External', keywords: 'peaks agence agency entreprise business site website', external: true },
];
---

<div class="homecommands-launcher">
  <button class="command-trigger" type="button" data-command-open aria-haspopup="dialog" aria-controls="homecommands" aria-label={fr ? 'Ouvrir la navigation rapide' : 'Open quick navigation'}>
    <svg viewBox="0 0 20 20" width="17" height="17" fill="none" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.35" /><path d="m12.5 12.5 4 4" stroke="currentColor" stroke-width="1.35" /></svg>
    <span>{fr ? 'Navigation rapide' : 'Quick navigation'}</span>
    <kbd data-command-key aria-hidden="true">⌘ K</kbd>
  </button>
</div>

<dialog id="homecommands" class="commands-dialog" aria-labelledby="homecommands-title" data-command-language={lang}>
  <div class="commands-heading"><h2 id="homecommands-title">{fr ? 'Navigation rapide' : 'Quick navigation'}</h2><button class="commands-close" type="button" data-command-close aria-label={fr ? 'Fermer la navigation rapide' : 'Close quick navigation'}><span aria-hidden="true">Esc</span></button></div>
  <div class="commands-search">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.4" /><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="1.4" /></svg>
    <label for="homecommands-search" class="commands-sr-only">{fr ? 'Rechercher une page ou un projet' : 'Search for a page or project'}</label>
    <input id="homecommands-search" type="text" placeholder={fr ? 'Une page, un projet…' : 'A page, a project…'} role="combobox" aria-autocomplete="list" aria-controls="homecommands-results" aria-expanded="false" autocomplete="off" spellcheck="false" autocapitalize="off" enterkeyhint="go" />
  </div>
  <div class="commands-results-wrap" tabindex="-1">
    <ul id="homecommands-results" class="commands-results" role="listbox" aria-label={fr ? 'Pages et projets' : 'Pages and projects'}>
      {entries.map((entry, i) => <li class="command-row" role="presentation" data-command-row data-command-search={`${entry.label} ${entry.keywords}`}>
        <a id={`homecommands-${entry.id}`} class="command-option" href={entry.href} role="option" aria-selected="false" tabindex="-1" data-command-option>
          <span class="command-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="command-text"><span class="command-label">{entry.label}</span><span class="command-detail">{entry.detail}</span></span>
          <span class="command-kind">{entry.kind}</span><span class="command-arrow" aria-hidden="true">{entry.external ? '↗' : '↵'}</span>
        </a>
      </li>)}
    </ul>
    <p class="commands-empty" data-command-empty hidden>{fr ? 'Aucun résultat. Essayez un autre mot.' : 'No results. Try a different word.'}</p>
  </div>
  <div class="commands-footer"><p data-command-count role="status" aria-live="polite" aria-atomic="true"></p><div class="commands-hints" aria-hidden="true"><span><kbd>↑</kbd><kbd>↓</kbd> {fr ? 'naviguer' : 'navigate'}</span><span><kbd>↵</kbd> {fr ? 'ouvrir' : 'open'}</span></div></div>
</dialog>

<script>
  import '../scripts/commands';
</script>

<style>
  .homecommands-launcher { display: inline-flex; }
  .command-trigger { display: inline-flex; gap: 11px; align-items: center; min-height: 43px; border: 1px solid var(--line, #343538); border-radius: 0; padding: 9px 11px 9px 14px; background: transparent; color: var(--ink, #f1f1ee); font: 12px var(--sans, sans-serif); cursor: pointer; transition: background .18s, border-color .18s; }
  .command-trigger > svg { color: var(--muted, #a0a2a6); }
  .command-trigger:hover { background: #ffffff08; border-color: #75777b; }
  .command-trigger kbd { margin-left: 18px; border: 1px solid var(--line, #343538); padding: 3px 6px; font: 10px var(--mono, monospace); color: var(--muted, #a0a2a6); }
  .command-trigger:focus-visible, .commands-close:focus-visible { outline: 2px solid var(--ink, #f1f1ee); outline-offset: 4px; }
  .commands-dialog { position: fixed; inset: min(13vh, 130px) 0 auto; width: min(660px, calc(100vw - 40px)); max-width: none; max-height: calc(100dvh - min(13vh, 130px) - 28px); margin: 0 auto; padding: 0; overflow: hidden; background: #151619; color: var(--ink, #f1f1ee); border: 1px solid #515359; border-radius: 0; box-shadow: 0 24px 100px #0009; color-scheme: dark; }
  .commands-dialog[open] { display: flex; flex-direction: column; animation: command-enter .17s ease-out both; }
  .commands-dialog::backdrop { background: #000b; backdrop-filter: blur(5px); }
  .commands-heading { display: flex; align-items: center; justify-content: space-between; padding: 19px 22px 15px; gap: 20px; }
  .commands-heading h2 { font: 500 14px/1.4 var(--sans, sans-serif); letter-spacing: -.015em; }
  .commands-close { display: inline-flex; align-items: center; justify-content: center; min-height: 28px; min-width: 38px; padding: 5px 8px; border: 1px solid #44464b; border-radius: 0; background: transparent; color: #b5b7bd; font: 10px var(--mono, monospace); cursor: pointer; }
  .commands-close:hover { color: #fff; border-color: #9c9ea3; }
  .commands-search { display: flex; align-items: center; gap: 14px; padding: 0 22px 20px; border-bottom: 1px solid #34363b; }
  .commands-search > svg { flex-shrink: 0; color: #a0a2a6; }
  .commands-search input { min-width: 0; width: 100%; border: 0; border-radius: 0; padding: 10px 0; background: transparent; color: #f1f1ee; font: 400 22px/1.4 var(--sans, sans-serif); letter-spacing: -.025em; outline: none; }
  .commands-search input::placeholder { color: #8f9298; opacity: 1; }
  .commands-search:focus-within { border-bottom-color: #a0a2a6; }
  .commands-results-wrap { min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 8px; scrollbar-width: thin; scrollbar-color: #55585e #151619; }
  .commands-results { padding: 0; margin: 0; list-style: none; }
  .command-row[hidden], .commands-empty[hidden] { display: none; }
  .command-option { display: flex; align-items: center; gap: 15px; min-height: 62px; padding: 11px 13px; color: #f1f1ee; border: 1px solid transparent; text-decoration: none; scroll-margin-block: 8px; }
  .command-option[aria-selected='true'] { background: #25272c; border-color: #41444b; }
  .command-option:focus-visible { outline: 2px solid #f1f1ee; outline-offset: -2px; }
  .command-index { flex-shrink: 0; width: 18px; color: #93969d; font: 10px var(--mono, monospace); }
  .command-text { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 3px; }
  .command-label { font: 500 14px/1.35 var(--sans, sans-serif); letter-spacing: -.015em; }
  .command-detail { font: 11px/1.45 var(--sans, sans-serif); color: #a0a2a9; }
  .command-kind { margin-left: auto; color: #a0a2a9; font: 9px var(--mono, monospace); }
  .command-arrow { min-width: 17px; margin-left: 2px; color: #d8d9dd; font-size: 18px; line-height: 1; }
  .commands-empty { padding: 35px 20px; margin: 0; color: #b2b4ba; font: 13px/1.5 var(--sans, sans-serif); }
  .commands-footer { flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 46px; border-top: 1px solid #34363b; padding: 12px 22px; color: #a0a2a9; font: 10px/1.4 var(--mono, monospace); }
  .commands-footer p { margin: 0; line-height: inherit; }
  .commands-hints { display: flex; gap: 18px; }
  .commands-hints > span { display: flex; gap: 5px; align-items: center; }
  .commands-hints kbd { font: inherit; color: #d3d5da; }
  .commands-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  @keyframes command-enter { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: translateY(0); } }
  @media (max-width: 600px) {
    .command-trigger { min-height: 44px; }
    .command-trigger kbd { margin-left: 10px; }
    .commands-dialog { inset-block-start: 22px; width: calc(100vw - 24px); max-height: calc(100dvh - 44px); }
    .commands-heading { padding: 14px 15px 7px; }
    .commands-close { min-height: 36px; min-width: 42px; }
    .commands-search { padding: 0 15px 13px; gap: 10px; }
    .commands-search input { font-size: 19px; }
    .commands-results-wrap { padding: 6px; }
    .command-option { gap: 11px; padding: 11px 9px; min-height: 66px; }
    .command-detail { max-width: 255px; font-size: 10px; }
    .command-kind { display: none; }
    .command-arrow { margin-left: 0; }
    .commands-footer { gap: 12px; padding: 12px 15px; font-size: 9px; }
    .commands-hints { gap: 12px; }
  }
  @media (prefers-reduced-motion: reduce) { .command-trigger, .commands-dialog[open] { animation: none; transition: none; } }
</style>
