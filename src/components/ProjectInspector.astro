---
import { Code } from 'astro:components';
import type {Lang} from '../content/site';
import type {Project} from '../content/projects';
import {projectInspectors} from '../content/project-inspector';
interface Props {lang:Lang;project:Project}
const {lang,project}=Astro.props;const fr=lang==='fr';const inspector=projectInspectors[project.key];
---
<div class="project-inspector" data-inspector={project.key}>
  <div class="inspector-tree">
    <img src={project.image} alt="" width="1440" height="900" loading="lazy"/>
    <span class="inspector-tree-label">{fr?'Explorer le projet':'Explore the project'}</span>
    <div class="inspector-file-list" role="tablist" aria-orientation="vertical" aria-label={fr?'Parties du code':'Code sections'}>
      {inspector.roles.map((role,index)=><button type="button" class:list={['inspector-file',{'is-active':index===0}]} data-inspector-tab={index} role="tab" id={`source-tab-${project.key}-${index}`} aria-controls={`source-panel-${project.key}-${index}`} aria-selected={index===0?'true':'false'} tabindex={index===0?0:-1}><span class="inspector-file-number">0{index+1}</span><span>{role.label[lang]}</span><span aria-hidden="true">↗</span></button>)}
    </div>
    <a class="inspector-repository" href={project.repo} target="_blank" rel="noreferrer">{fr?'Dépôt complet':'Full repository'}<span aria-hidden="true">↗</span></a>
  </div>
  <div class="inspector-editor">
    {inspector.excerpts.map((excerpt,index)=><div class="inspector-source" data-inspector-panel={index} id={`source-panel-${project.key}-${index}`} role="tabpanel" aria-labelledby={`source-tab-${project.key}-${index}`} hidden={index!==0}>
      <div class="inspector-filebar"><span title={excerpt.file}>{excerpt.file}</span><button type="button" data-copy-code data-copied={fr?'Copié':'Copied'} aria-label={fr?'Copier cet extrait de code':'Copy this code excerpt'}>{fr?'Copier':'Copy'}</button><span class="inspector-copy-feedback" data-copy-status role="status" aria-live="polite" aria-atomic="true"></span></div>
      <div class="inspector-code" tabindex="0" aria-label={fr?'Extrait de code, défilement horizontal possible':'Code excerpt, can be scrolled horizontally'}><Code code={excerpt.code} lang={excerpt.language} theme="github-dark" /></div>
      <div class="inspector-explanation"><h3>{excerpt.label[lang]}</h3><p>{excerpt.description[lang]}</p><a href={excerpt.source} target="_blank" rel="noreferrer">{fr?'Lire dans le code source':'Read the original source'}<span aria-hidden="true">↗</span></a></div>
    </div>)}
  </div>
</div>
<style>
.inspector-copy-feedback{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}.project-inspector{display:grid;grid-template-columns:190px minmax(0,1fr);background:#151619;min-height:410px}.inspector-tree{border-right:1px solid #343538;padding:17px 12px;display:flex;flex-direction:column;min-width:0}.inspector-tree>img{width:100%;aspect-ratio:1.65;object-fit:cover;object-position:top;opacity:.75;margin-bottom:22px}.inspector-tree-label{font:8px/1.5 var(--mono);color:var(--muted);padding:0 7px;margin-bottom:10px}.inspector-file-list{display:flex;flex-direction:column;gap:4px}.inspector-file{display:flex;align-items:center;gap:9px;width:100%;padding:10px 8px;min-height:44px;border:1px solid transparent;background:transparent;text-align:left;font-size:10px;color:#a0a2a6;cursor:pointer}.inspector-file>span:last-child{margin-left:auto;font-size:13px}.inspector-file-number{font-family:var(--mono);font-size:8px;opacity:.6}.inspector-file.is-active{background:#26282c;border-color:#404247;color:var(--ink)}.inspector-file:hover{color:var(--ink)}.inspector-repository{font:9px/1.4 var(--mono);margin-top:auto;padding:25px 7px 3px;display:flex;justify-content:space-between}.inspector-editor{min-width:0}.inspector-filebar{display:flex;align-items:center;gap:12px;border-bottom:1px solid #343538;padding:8px 14px;font:8px/1.5 var(--mono);color:#b8bac0;min-height:42px}.inspector-filebar>span{min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1}.inspector-filebar>button{font:8px/1.5 var(--mono);background:#24262b;border:1px solid #44464b;padding:5px 9px;cursor:pointer;min-height:30px}.inspector-code{padding:21px 18px;background:#191b1f;min-height:220px;max-height:330px;overflow:auto}.inspector-code :global(pre){background:transparent!important;margin:0;font:10px/1.9 var(--mono);tab-size:2;min-width:fit-content}.inspector-code :global(code){font-family:inherit}.inspector-explanation{padding:20px 19px 24px}.inspector-explanation h3{font-size:17px;font-weight:500;letter-spacing:-.025em}.inspector-explanation p{font-size:11px;line-height:1.65;color:#aaadb4;margin-top:10px;max-width:620px}.inspector-explanation a{font-size:9px;display:inline-flex;gap:22px;min-height:36px;align-items:center;margin-top:8px;border-bottom:1px solid #53555b}.inspector-explanation a>span{font-size:17px}
:global(.workspace-expanded) .project-inspector{grid-template-columns:245px minmax(0,1fr);min-height:520px}:global(.workspace-expanded) .inspector-code{min-height:300px;max-height:48vh;padding:28px}:global(.workspace-expanded) .inspector-code :global(pre){font-size:13px}:global(.workspace-expanded) .inspector-file{font-size:12px}:global(.workspace-expanded) .inspector-explanation p{font-size:14px}:global(.workspace-expanded) .inspector-filebar{font-size:10px}:global(.workspace-expanded) .inspector-explanation h3{font-size:24px}
@media(max-width:800px){.project-inspector{display:block;min-height:0}.inspector-tree{border-right:0;border-bottom:1px solid #343538;padding:8px}.inspector-tree>img,.inspector-tree-label,.inspector-repository{display:none}.inspector-file-list{flex-direction:row;gap:2px}.inspector-file{font-size:8px;gap:5px;min-height:44px;padding:7px 6px;justify-content:center}.inspector-file>span:last-child{display:none}.inspector-file-number{font-size:7px}.inspector-filebar{padding:6px 10px;font-size:7px}.inspector-code{padding:18px 12px;min-height:180px;max-height:290px}.inspector-code :global(pre){font-size:9px;line-height:1.8}.inspector-explanation{padding:18px 14px}.inspector-explanation h3{font-size:20px}.inspector-explanation p{font-size:12px}.inspector-explanation a{font-size:10px;min-height:44px}:global(.workspace-expanded) .project-inspector{display:block;min-height:0}:global(.workspace-expanded) .inspector-code{padding:18px 12px;min-height:190px;max-height:40vh}:global(.workspace-expanded) .inspector-code :global(pre){font-size:10px}:global(.workspace-expanded) .inspector-explanation p{font-size:12px}:global(.workspace-expanded) .inspector-file{font-size:9px}}

@media(max-width:800px){.inspector-file,:global(.workspace-expanded) .inspector-file{font-size:10px}.inspector-code :global(pre),:global(.workspace-expanded) .inspector-code :global(pre){font-size:11px}.inspector-filebar>button{min-height:40px;font-size:9px}.inspector-filebar{font-size:8px}.inspector-code{max-height:310px}}
@media(max-width:360px){.inspector-file,:global(.workspace-expanded) .inspector-file{font-size:9px}.inspector-file-number{display:none}}
</style>
