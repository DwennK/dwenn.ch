---
import { type Lang } from '../content/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const fr = lang === 'fr';
const id = `canapey-${Math.random().toString(36).slice(2,10)}`;
const apps = [
  { name:'Netflix', theme:'netflix', logo:'netflix.svg' },
  { name:'YouTube', theme:'youtube', logo:'youtube.svg' },
  { name:'Spotify', theme:'spotify', logo:'spotify.png' },
  { name:'Internet', theme:'internet', logo:'' },
  { name:'Steam', theme:'steam', logo:'steam.svg' },
];
---
<div class="canapey-playground" data-canapey-playground data-lang={lang} data-view="carousel" aria-label={fr ? 'Démonstration de navigation Canapey' : 'Canapey navigation demonstration'}>
  <div class="pg-toolbar"><span>canapey / navigation.ts</span><button type="button" class="pg-view-switch" data-pg-view aria-pressed="false">{fr ? 'Vue grille' : 'Grid view'} <span aria-hidden="true">⊞</span></button></div>
  <div class="pg-scene">
    <img class="pg-background" data-pg-background alt="" width="1920" height="1080" />
    <div class="pg-scene-shade" aria-hidden="true"></div>
    <div class="pg-scene-heading"><span>{fr ? 'BIBLIOTHÈQUE DE DÉMONSTRATION' : 'DEMONSTRATION LIBRARY'}</span><strong data-pg-title>Netflix</strong></div>
    <div class="pg-card-viewport" data-pg-viewport>
      <div class="pg-cards" id={id} data-pg-cards role="listbox" aria-label={fr ? 'Applications de démonstration' : 'Demonstration applications'} aria-describedby={`${id}-instructions`}>
        {apps.map((app,index)=><button type="button" role="option" aria-selected={index===0?'true':'false'} aria-label={`${app.name} — ${fr?'démonstration':'demonstration'}`} tabindex={index===0?0:-1} class:list={['pg-card',{'is-selected':index===0}]} data-pg-card={index} data-theme={app.theme} data-name={app.name}>
          <span class="pg-card-visual"><img class="pg-card-art" src={`/images/playground/${app.theme}-card.webp`} alt="" width="640" height="360" loading="lazy" draggable="false" />{app.logo?<img class={`pg-card-logo pg-card-logo--${app.theme}`} src={`/images/playground/${app.logo}`} alt="" loading="lazy" />:<span class="pg-card-wordmark">Internet</span>}</span>
          <span class="pg-card-caption">{app.name}<span aria-hidden="true">●</span></span>
        </button>)}
      </div>
    </div>
  </div>
  <div class="pg-controls">
    <div class="pg-input-row"><button type="button" class="pg-enter" data-pg-enter aria-controls={id}>{fr ? 'Essayer au clavier' : 'Try the keyboard'} <span aria-hidden="true">↵</span></button><div class="pg-direction-pad" role="group" aria-label={fr?'Déplacer la sélection':'Move selection'}>{[{key:'left',symbol:'←',fr:'Gauche',en:'Left'},{key:'up',symbol:'↑',fr:'Haut',en:'Up'},{key:'down',symbol:'↓',fr:'Bas',en:'Down'},{key:'right',symbol:'→',fr:'Droite',en:'Right'}].map(action=><button type="button" data-pg-action={action.key} aria-label={fr?action.fr:action.en}>{action.symbol}</button>)}</div></div>
    <div class="pg-state-row"><code data-pg-state>index: 0 · view: carousel</code><a href="https://github.com/DwennK/canapey-launcher/blob/main/src/lib/navigation.ts" target="_blank" rel="noopener noreferrer">{fr?'Code source':'Source code'} ↗</a></div>
    <p class="pg-note" id={`${id}-instructions`}>{fr?'Démonstration de navigation, sans lancement d’applications.':'Navigation demonstration. No applications are launched.'}<span class="pg-keyboard-note"> {fr?'Flèches pour naviguer, Échap pour sortir.':'Arrow keys to navigate; Escape to leave.'}</span></p>
    <span class="pg-sr-only" data-pg-status aria-live="polite" aria-atomic="true"></span>
  </div>
</div>
<script>
  import { initCanapeyPlaygrounds } from '../scripts/canapey-playground';
  initCanapeyPlaygrounds();
</script>
<style>
.canapey-playground{height:420px;width:100%;min-width:0;display:grid;grid-template-rows:38px minmax(0,1fr) 108px;background:#111214;color:#f1f1ee;overflow:hidden;font-family:var(--sans,Arial,sans-serif)}.pg-toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:0 16px;border-bottom:1px solid #343538;font-family:var(--mono,monospace);font-size:10px;color:#aeb0b7}.pg-toolbar button{color:#f1f1ee;background:none;border:0;cursor:pointer;font:inherit;min-height:36px;padding:0 5px;display:flex;align-items:center;gap:12px}.pg-toolbar button[aria-pressed=true]{text-decoration:underline;text-underline-offset:5px}.pg-scene{position:relative;isolation:isolate;overflow:hidden;background:#171b1e}.pg-background{position:absolute;z-index:-2;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 58%;opacity:.85}.pg-scene-shade{position:absolute;z-index:-1;inset:0;background:linear-gradient(180deg,#080b11a0 0%,#0c101127 35%,#080b11c9 100%)}.pg-scene-heading{position:absolute;left:22px;top:16px;display:flex;flex-direction:column;gap:6px}.pg-scene-heading>span{font-family:var(--mono,monospace);font-size:8px;color:#c3c6ca;letter-spacing:.05em}.pg-scene-heading>strong{font-size:32px;line-height:1.05;font-weight:550;letter-spacing:-.045em}.pg-card-viewport{position:absolute;left:22px;right:22px;bottom:16px;overflow:clip;padding:6px}.pg-cards{display:flex;gap:12px;transform:translateX(var(--pg-shift,0px));transition:transform .25s cubic-bezier(.2,.7,.2,1);will-change:transform}.pg-card{flex:0 0 calc((100% - 24px)/3);display:block;background:none;border:0;color:#cdd0d5;text-align:left;padding:0;font:inherit;cursor:pointer;min-width:0;opacity:.65;transition:opacity .18s,transform .2s;transform:scale(.97);transform-origin:center bottom}.pg-card.is-selected{opacity:1;transform:scale(1)}.pg-card-visual{position:relative;isolation:isolate;display:flex;align-items:center;justify-content:center;height:88px;overflow:hidden;border:1px solid #ffffff30;border-radius:5px;background:#17191b;transition:border-color .18s,box-shadow .18s}.pg-card.is-selected .pg-card-visual{border-color:#f1f1ee;box-shadow:0 0 0 2px #f1f1ee35}.pg-card-art{position:absolute;z-index:-1;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(.65)}.pg-card-logo{max-width:64%;max-height:32px;object-fit:contain;width:auto;height:auto}.pg-card-logo--netflix{max-height:35px}.pg-card-logo--youtube{max-height:28px}.pg-card-wordmark{font-size:21px;font-weight:500;letter-spacing:-.045em}.pg-card-caption{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:10px;padding-top:8px;line-height:1.1}.pg-card-caption>span{opacity:0}.pg-card.is-selected .pg-card-caption>span{opacity:1}.pg-card:focus-visible{outline:2px solid #f1f1ee;outline-offset:3px;border-radius:3px}.canapey-playground[data-view=grid] .pg-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px 12px;transform:none}.canapey-playground[data-view=grid] .pg-card-visual{height:45px}.canapey-playground[data-view=grid] .pg-card-logo{max-height:23px}.canapey-playground[data-view=grid] .pg-card-caption{padding-top:4px;font-size:9px}.canapey-playground[data-view=grid] .pg-card-wordmark{font-size:16px}.pg-controls{border-top:1px solid #343538;padding:8px 16px 9px;background:#151619;min-width:0}.pg-input-row{display:flex;align-items:center;justify-content:space-between;gap:8px}.pg-enter{display:flex;gap:10px;align-items:center;background:none;border:0;padding:0;color:#f1f1ee;font-family:var(--sans,Arial,sans-serif);font-size:11px;cursor:pointer;min-height:38px}.pg-enter span{color:#8e929a}.pg-direction-pad{display:flex;gap:4px}.pg-direction-pad button{display:flex;align-items:center;justify-content:center;border:1px solid #45474d;background:#202227;color:#f1f1ee;border-radius:3px;width:38px;height:38px;font:18px var(--sans,Arial,sans-serif);cursor:pointer;transition:background .18s}.pg-direction-pad button:hover,.pg-direction-pad button:active{background:#383b41}.pg-state-row{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:6px;font-family:var(--mono,monospace);font-size:9px;color:#b2b5bc}.pg-state-row code{font:inherit}.pg-state-row a{color:#e4e5e8;text-decoration:underline;text-underline-offset:3px;white-space:nowrap}.pg-note{font-family:var(--mono,monospace);font-size:8px;line-height:1.45;color:#8e929a;margin:6px 0 0}.pg-keyboard-note{display:none}.pg-sr-only{position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
@media(max-width:800px){.canapey-playground{height:380px;grid-template-rows:36px minmax(0,1fr) 116px}.pg-toolbar{padding:0 12px;font-size:8px}.pg-scene-heading{left:16px;top:14px}.pg-scene-heading>span{font-size:7px}.pg-scene-heading>strong{font-size:27px}.pg-card-viewport{left:10px;right:10px;bottom:12px}.pg-cards{gap:9px}.pg-card{flex-basis:calc((100% - 18px)/3)}.pg-card-visual{height:65px}.pg-card-logo{max-height:24px;max-width:70%}.pg-card-logo--netflix{max-height:28px}.pg-card-logo--youtube{max-height:22px}.pg-card-wordmark{font-size:14px}.pg-card-caption{font-size:8px;padding-top:6px}.canapey-playground[data-view=grid] .pg-cards{gap:8px 9px}.canapey-playground[data-view=grid] .pg-card-visual{height:39px}.canapey-playground[data-view=grid] .pg-card-logo{max-height:19px}.canapey-playground[data-view=grid] .pg-card-caption{font-size:8px}.canapey-playground[data-view=grid] .pg-card-wordmark{font-size:13px}.pg-controls{padding:7px 12px}.pg-enter{font-size:11px;max-width:110px;text-align:left;line-height:1.4;min-height:44px}.pg-direction-pad{gap:3px}.pg-direction-pad button{width:44px;height:44px;font-size:17px}.pg-state-row{font-size:9px;margin-top:4px}.pg-note{font-size:9px;margin-top:6px;max-width:100%}}
@media(prefers-reduced-motion:reduce){.pg-cards,.pg-card,.pg-card-visual,.pg-direction-pad button{transition:none!important;will-change:auto}.pg-card{transform:none}}
</style>
